    <http-policy:proxy name="{{{policyId}}}-custom-policy">
        <http-policy:source propagateMessageTransformations="true">
            <logger level="WARN" message="=== Akto Policy Execution Started ===" />
            <try>
                <!-- Capture request details -->
                <set-variable variableName="taRequestHost" value="#[attributes.headers.host default 'localhost']" />
                <set-variable variableName="taRequestMethod" value="#[attributes.method default 'GET']" />
                <set-variable variableName="taRequestTarget" value="#[attributes.rawRequestUri default '/']" />
                <set-variable variableName="taRequestScheme" value="#[attributes.scheme default 'http']" />

                <ee:transform>
                    <ee:variables>
                        <ee:set-variable variableName="taRequestStartMs"><![CDATA[%dw 2.0
                            import * from dw::util::Timer
                            output application/json
                            ---
                            currentMilliseconds()
                        ]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <logger level="WARN" message="Request processing started" />

                <!-- Capture request headers -->
                <choice>
                    <when expression="true">
                        <foreach collection="#[message.attributes.headers]">
                            <set-variable variableName="taRequestHeaders" value="#[vars.taRequestHeaders default {} ++ payload]" />
                        </foreach>

                        <ee:transform>
                            <ee:variables>
                                <ee:set-variable variableName="taRequestHeadersProcessed"><![CDATA[%dw 2.0
                                    output application/json
                                    var reqHeaders = vars.taRequestHeaders default {}
                                    ---
                                    (reqHeaders mapObject ((value, key, index) -> {
                                        (key): if (value != null) (value) else ""
                                    }))
                                ]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <logger level="INFO" message="Request Header capture disabled" />
                    </otherwise>
                </choice>

                <!-- Capture request body if enabled -->
                <choice>
                    <when expression="true">
                        <ee:transform>
                            <ee:variables>
                                <ee:set-variable variableName="taRequestBodyOrig"><![CDATA[%dw 2.0
                                    output application/json
                                    ---
                                    payload.^raw as String
                                ]]></ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <logger level="INFO" message="Request Body capture disabled" />
                    </otherwise>
                </choice>

                <logger level="INFO" message="Request pre-processing completed" />

                <http-policy:execute-next/>

                <!-- Process Response Post request handling -->
                <async>
                    <try>
                        <logger level="INFO" message="Response post-processing started" />

                        <choice>
                            <when expression="true">
                                <!-- Capture response body -->
                                <ee:transform>
                                    <ee:variables>
                                        <ee:set-variable variableName="taResponseBodyOrig"><![CDATA[%dw 2.0
                                            output application/json
                                            ---
                                            payload.^raw as String
                                        ]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>
                        </choice>

                        <!-- Create the final payload with the specified structure -->
                        <ee:transform>
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
                                    output application/json
                                    ---
                                    {
                                        batchData: [
                                            {
                                                path: vars.taRequestScheme ++ "://" ++ vars.taRequestHost ++ vars.taRequestTarget,
                                                requestHeaders: vars.taRequestHeadersProcessed,
                                                responseHeaders: #[message.attributes.headers],
                                                method: vars.taRequestMethod,
                                                requestPayload: vars.taRequestBodyOrig,
                                                responsePayload: vars.taResponseBodyOrig,
                                                ip: "0.0.0.0",
                                                time: vars.taRequestStartMs,
                                                statusCode: message.attributes.statusCode default 200,
                                                type: "HTTP/1.1",
                                                status: "",
                                                akto_account_id: "1000000",
                                                akto_vxlan_id: "123",
                                                is_pending: "false",
                                                source: "MIRRORING"
                                            }
                                        ]
                                    }
                                ]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>

                        <!-- Send the captured data to the external endpoint via HTTP POST -->
                        <http:request method="POST" url="{{ TA-REPORTING-ENDPOINT }}">
                        </http:request>

                        <logger level="INFO" message="Request sent to external endpoint successfully" />

                        <error-handler>
                            <on-error-continue>
                                <logger level="ERROR" message="error in processing: #[error]" />
                            </on-error-continue>
                        </error-handler>

                    </try>

                </async>

            </try>

           
        </http-policy:source>
    </http-policy:proxy>
</mule>
